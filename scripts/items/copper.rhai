fn define(mod_info) {
    import "factoreras/scripts/utils" as utils;

    utils::define_item(mod_info, "Copper Wire", "factoreras/assets/items/CopperWire.png", "Copper but very thin. Could be useful to conduct electricity or something idk...");
    utils::define_item(mod_info, "Copper Coil", "factoreras/assets/items/CopperCoil.png", "A bunch of very thin copper made into big copper. Does it feel like a step back?");
}