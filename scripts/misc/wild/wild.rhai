fn define(mod_info) {
    import "factoreras/scripts/misc/wild/rubber_log" as rubber_log;
    import "factoreras/scripts/misc/wild/rubber_leaves" as rubber_leaves;
    import "factoreras/scripts/misc/wild/rubber_sapling" as rubber_sapling;

    rubber_log::define(mod_info);
    rubber_leaves::define(mod_info);
    rubber_sapling::define(mod_info);
}